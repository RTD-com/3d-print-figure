{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex 阶段结果",
  "type": "object",
  "required": [
    "stage",
    "status",
    "artifacts",
    "checks",
    "issues",
    "notes"
  ],
  "properties": {
    "stage": {
      "type": "string",
      "enum": [
        "S3",
        "S4",
        "S5",
        "S7",
        "S8",
        "S9",
        "S10"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "failed",
        "blocked",
        "partial"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "object"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "severity",
          "problem"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "blocker",
              "major",
              "minor"
            ]
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
